# FleetSphere Backend Configuration Template
PORT=5000
NODE_ENV=production

# MongoDB Atlas or self-hosted MongoDB Connection URI
# e.g.: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/fleetsphere?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster.mongodb.net/fleetsphere

# Strong random secret key for signing JWT tokens (min 32 characters)
JWT_SECRET=fleetsphere_production_super_secret_jwt_key_2026_enterprise

# Optional: Allowed CORS Origins (comma separated if multiple, or * for open API)
CLIENT_URL=*
